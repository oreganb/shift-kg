# SHIFT-RR-00 : Infer Flexumer from asset ownership
# Source: SHIFT Ontology.docx, "SWRL-Like Pseudocode"
# Expressible in SWRL: YES (conjunctive, no counting/aggregation)
# TYPING NOTE: the ABox types every string as xsd:string. Under RDF 1.1 a
# simple literal IS xsd:string, but triple-pattern matching and the IN
# operator use term equality, so an untyped "Pending" in a rule body
# silently matches NOTHING rather than raising. Datatypes are explicit here.
PREFIX shift: <https://w3id.org/shift/core#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?a a shift:Flexumer }
WHERE {
  ?a a shift:Actor ;
     shift:ownsAsset ?c , ?g .
  ?c shift:assetFunction "consumption"^^xsd:string .
  ?g shift:assetFunction ?gf .
  FILTER(?gf IN ("generation"^^xsd:string, "storage"^^xsd:string))
}
