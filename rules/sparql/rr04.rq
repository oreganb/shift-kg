# SHIFT-RR-04 : Validate trade deadline expiry
# Expressible in SWRL: PARTIALLY — SWRL has no now(); the evaluation timestamp
# must be injected by the host application. NOW is bound by the runner.
# TYPING NOTE: the ABox types every string as xsd:string. Under RDF 1.1 a
# simple literal IS xsd:string, but triple-pattern matching and the IN
# operator use term equality, so an untyped "Pending" in a rule body
# silently matches NOTHING rather than raising. Datatypes are explicit here.
PREFIX shift: <https://w3id.org/shift/core#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?t shift:tradeStatus "Expired" }
WHERE {
  ?t a shift:FlexibilityTrade ;
     shift:tradeStatus ?s ;
     shift:deliveryEndTime ?end .
  FILTER(?s IN ("Pending"^^xsd:string, "InProgress"^^xsd:string))
  FILTER(?end < ?NOW)
}
