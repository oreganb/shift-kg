# SHIFT-RR-01 : Infer Prosumer from >=3 distinct confirmed sales
# Expressible in SWRL: NO — requires COUNT DISTINCT. SWRL has no aggregation.
# The documentation works around this by writing out ?t1,?t2,?t3 with pairwise
# inequality, which only tests ">=3" and does not generalise to ">=n".
# TYPING NOTE: the ABox types every string as xsd:string. Under RDF 1.1 a
# simple literal IS xsd:string, but triple-pattern matching and the IN
# operator use term equality, so an untyped "Pending" in a rule body
# silently matches NOTHING rather than raising. Datatypes are explicit here.
PREFIX shift: <https://w3id.org/shift/core#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?a a shift:Prosumer }
WHERE {
  SELECT ?a (COUNT(DISTINCT ?t) AS ?n) WHERE {
    ?t a shift:FlexibilityTrade ;
       shift:sellerActor ?a ;
       shift:tradeStatus "Confirmed"^^xsd:string .
  } GROUP BY ?a HAVING (COUNT(DISTINCT ?t) >= 3)
}
