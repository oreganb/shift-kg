            owl:unionOf ( shift:DemandResponseService shift:FrequencyRegulationService shift:ReserveCapacityService shift:VoltageSupportService ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( shift:DSO shift:MarketOperator shift:TSO ) ] ;
    skos:note "Domain repair v0.1.1: legacy artefacts asserted 4 separate rdfs:domain triples (intersection semantics); replaced with owl:unionOf."@en,
        "Range repair v0.1.1: legacy artefacts asserted 3 separate rdfs:range triples (intersection semantics); replaced with owl:unionOf."@en .

