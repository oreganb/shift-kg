    dcterms:creator "Brian O'Regan" ;
    dcterms:description "Semantic Hierarchy for Intelligent Flexibility & Trading. Core TBox: actors, assets, flexibility services, contracts, trades, schedules, forecasts, tariffs, trade windows, nodes and platforms."@en ;
