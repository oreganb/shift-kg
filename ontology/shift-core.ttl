shift:Consumer a owl:Class ;
    rdfs:label "Consumer"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/core> ;
    rdfs:subClassOf shift:Actor .

shift:Flexumer a owl:Class ;
    rdfs:label "Flexumer"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/core> ;
    rdfs:subClassOf shift:Actor .

shift:Producer a owl:Class ;
