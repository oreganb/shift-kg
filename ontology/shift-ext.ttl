shift:backupTrade a owl:ObjectProperty ;
    rdfs:label "backupTrade"@en ;
    rdfs:comment "Renamed from the documentation's 'backupTradeList': RDF has no list-valued object properties; multiplicity is expressed by repeated triples."@en ;
    rdfs:domain shift:FlexibilityTrade ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range shift:FlexibilityTrade ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-08. Not present in the pre-v0.1.0 artefacts."@en .

