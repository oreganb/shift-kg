    rdfs:domain shift:Node ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:boolean ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-19. Not present in the pre-v0.1.0 artefacts."@en .

shift:averageDeliveryRate_percent a owl:DatatypeProperty ;
    rdfs:label "averageDeliveryRate_percent"@en ;
    rdfs:domain shift:Actor ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:decimal ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-14. Not present in the pre-v0.1.0 artefacts."@en .

