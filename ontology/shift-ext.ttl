shift:CommunityMarketCircle a owl:Class ;
    rdfs:label "CommunityMarketCircle"@en ;
    rdfs:comment "A bounded trust/governance group of Actors within which trades may be fast-tracked. The legacy rule documentation asserts CMC 'is a defined concept in the ontology'; it was not."@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf shift:Actor ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-16, RR-27. Not present in the pre-v0.1.0 artefacts."@en .

shift:ActivationEvent a owl:Class ;
    rdfs:label "ActivationEvent"@en ;
    rdfs:comment "A single activation attempt against an Asset, with outcome and timestamp."@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf owl:Thing ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-28. Not present in the pre-v0.1.0 artefacts."@en .

shift:DeliveryEvent a owl:Class ;
    rdfs:label "DeliveryEvent"@en ;
    rdfs:comment "A single observed delivery of a FlexibilityService, carrying committed vs measured values and a timestamp. Required for any performance rule."@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf owl:Thing ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-17, RR-26. Not present in the pre-v0.1.0 artefacts."@en .

shift:FlexibilityBundle a owl:Class ;
    rdfs:label "FlexibilityBundle"@en ;
    rdfs:comment "A geographically and temporally coherent group of FlexibilityService instances dispatched together."@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf owl:Thing ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-34. Not present in the pre-v0.1.0 artefacts."@en .

<https://w3id.org/shift/ext> a owl:Ontology ;
    dcterms:creator "Brian O'Regan" ;
    dcterms:description "Vocabulary referenced by reasoning rules SHIFT-RR-00 to SHIFT-RR-34 but not declared in the legacy SHIFT artefacts. Without this module no SHIFT rule can be evaluated, because the terms in the rule bodies do not resolve."@en ;
    dcterms:issued "2026-07-15"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-24"^^xsd:date ;
    dcterms:publisher "Tyndall National Institute / IERC, University College Cork" ;
    dcterms:title "SHIFT Ontology — Rule Vocabulary Extension"@en ;
    vann:preferredNamespacePrefix "shift" ;
    vann:preferredNamespaceUri "https://w3id.org/shift/core#" ;
    rdfs:comment "Funded under the CET Partnership Joint Call 2023, ref Cetp-FP2023-00114. Co-funded by the European Commission (GA No. 101069750) and national funding organisations including SEAI (Ireland)."@en ;
    owl:imports <https://w3id.org/shift/core> ;
    owl:versionIRI <https://w3id.org/shift/ext/1.0.0> ;
    owl:versionInfo "1.0.0" .

