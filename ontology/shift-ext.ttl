shift:complianceAuditDate a owl:DatatypeProperty ;
    rdfs:label "complianceAuditDate"@en ;
    rdfs:comment "Renamed from the documentation's 'auditDate' / core's 'lastAuditDate' (v0.1.1): the core property of that name has domain PeerFlexClearingMechanism; reusing it for Actors would create an intersection-domain defect."@en ;
    rdfs:domain shift:Actor ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:dateTime ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-14. Not present in the pre-v0.1.0 artefacts."@en .

