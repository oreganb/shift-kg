@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shift: <https://w3id.org/shift/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shift:BaseDynamicPlan a owl:Class ;
    rdfs:label "BaseDynamicPlan"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf shift:TariffPlan ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-20. Not present in the pre-v0.1.0 artefacts."@en .

shift:BatteryAsset a owl:Class ;
    rdfs:label "BatteryAsset"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf shift:StorageAsset ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-18, RR-21. Not present in the pre-v0.1.0 artefacts."@en .

shift:HeatPumpAsset a owl:Class ;
    rdfs:label "HeatPumpAsset"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf shift:ThermalAsset ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-18. Not present in the pre-v0.1.0 artefacts."@en .

shift:SolarPVAsset a owl:Class ;
    rdfs:label "SolarPVAsset"@en ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:subClassOf shift:GenerationAsset ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-18, RR-21. Not present in the pre-v0.1.0 artefacts."@en .

shift:activationReason a owl:DatatypeProperty ;
    rdfs:label "activationReason"@en ;
    rdfs:domain shift:FlexibilityService ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:string ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-05. Not present in the pre-v0.1.0 artefacts."@en .

shift:activationWindowEnd a owl:DatatypeProperty ;
    rdfs:label "activationWindowEnd"@en ;
    rdfs:domain shift:FlexibilityService ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:dateTime ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-34. Not present in the pre-v0.1.0 artefacts."@en .

shift:activationWindowStart a owl:DatatypeProperty ;
    rdfs:label "activationWindowStart"@en ;
    rdfs:comment "The documentation's 'activationWindow' is an interval; split into start/end because SPARQL/SWRL cannot compare opaque interval literals."@en ;
    rdfs:domain shift:FlexibilityService ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:dateTime ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-34. Not present in the pre-v0.1.0 artefacts."@en .

shift:assetFunction a owl:DatatypeProperty ;
    rdfs:label "assetFunction"@en ;
    rdfs:comment "One of consumption | generation | storage | thermal."@en ;
    rdfs:domain shift:Asset ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:string ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-00, RR-18. Not present in the pre-v0.1.0 artefacts."@en .

shift:assignedAsset a owl:ObjectProperty ;
    rdfs:label "assignedAsset"@en ;
    rdfs:domain shift:FlexibilityTrade ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range shift:Asset ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-07. Not present in the pre-v0.1.0 artefacts."@en .

shift:associatedActor a owl:ObjectProperty ;
    rdfs:label "associatedActor"@en ;
    rdfs:domain shift:FlexibilityContract ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range shift:Actor ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-26. Not present in the pre-v0.1.0 artefacts."@en .

shift:associatedContract a owl:ObjectProperty ;
