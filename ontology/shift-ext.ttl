shift:eventStatus a owl:DatatypeProperty ;
    rdfs:label "eventStatus"@en ;
    rdfs:domain shift:ActivationEvent ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:string ;
