    rdfs:label "avgMonthlyConsumption_kWh"@en ;
    rdfs:domain shift:Actor ;
    rdfs:isDefinedBy <https://w3id.org/shift/ext> ;
    rdfs:range xsd:float ;
    skos:note "Declared in SHIFT v0.1.0 to support RR-20, RR-21. Not present in the pre-v0.1.0 artefacts."@en .

shift:avgMonthlyGeneration_kWh a owl:DatatypeProperty ;
    rdfs:label "avgMonthlyGeneration_kWh"@en ;
